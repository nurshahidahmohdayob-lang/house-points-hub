{
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/commun-students.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/game",
      "destination": "https://zera-life-competencies.vercel.app/play",
      "permanent": false
    },
    {
      "source": "/map/:code",
      "destination": "/?map=:code",
      "permanent": false
    }
  ]
}
